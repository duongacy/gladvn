{
  "name": "gladvn",
  "version": "0.2.22",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "description": "A CLI to scaffold beautiful, accessible React components into your project. Powered by Tailwind CSS v4 and Base UI.",
  "keywords": [
    "react",
    "components",
    "ui",
    "shadcn",
    "tailwindcss",
    "radix-ui"
  ],
  "license": "MIT",
  "homepage": "https://gladvn.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/duongacy/gladvn"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "gladvn": "bin/cli.js"
  },
  "files": [
    "src",
    "bin",
    "scripts",
    "llms.txt"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build:app": "vite build -c vite.config.app.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "node scripts/postinstall.cjs || true",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": false
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.1",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@playwright/test": "^1.61.1",
    "@radix-ui/react-dialog": "^1.1.18",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.69.0",
    "prettier": "^3.9.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "shiki": "^4.3.1",
    "tailwindcss": "^4.3.1",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint"
    ]
  }
}
